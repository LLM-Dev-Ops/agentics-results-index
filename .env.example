# agentics-results-index Environment Configuration
# Copy this file to .env and configure for your environment

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Ruvector Postgres Connection (READ-ONLY)
# This service requires a read-only database user with SELECT-only permissions
RUVECTOR_DB_HOST=localhost
RUVECTOR_DB_PORT=5432
RUVECTOR_DB_NAME=ruvector
RUVECTOR_DB_USER=results_reader
RUVECTOR_DB_PASSWORD=your_secure_password_here
RUVECTOR_DB_SSL=true

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# Query Settings
QUERY_DEFAULT_PAGE_SIZE=20
QUERY_MAX_PAGE_SIZE=100
QUERY_TIMEOUT_MS=30000
